{
    "$schema": "https://schema.railpack.com",
    "packages": {
        "php": "8.5",
        "node": "26"
    },
    "steps": {
        "install:composer": {
            "commands": [
                "...",
                "composer install --no-dev --no-interaction --optimize-autoloader --no-scripts"
            ]
        }
    },
    "deploy": {
        "inputs": [
            { "step": "prune:node", "include": ["/app/node_modules"] },
            { "step": "build", "include": ["/"], "exclude": ["node_modules"] }
        ]
    }
}
